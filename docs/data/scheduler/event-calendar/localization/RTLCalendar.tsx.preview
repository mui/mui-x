<CacheProvider value={cacheRtl}>
  <ThemeProvider theme={theme}>
    <div dir="rtl" style={{ height: '600px', width: '100%' }}>
      <EventCalendar
        events={events}
        resources={resources}
        defaultVisibleDate={defaultVisibleDate}
        onEventsChange={setEvents}
      />
    </div>
  </ThemeProvider>
</CacheProvider>