<ThemeProvider theme={theme}>
  <Box sx={{ height: 460, width: '100%' }}>
    <DataGridPremium
      rows={rows}
      columns={columns}
      showToolbar
      pivotPanelOpen
      checkboxSelection
      pagination
      pageSizeOptions={[5, 10]}
      initialState={{ pagination: { paginationModel: { pageSize: 5 } } }}
    />
  </Box>
</ThemeProvider>