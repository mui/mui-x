<ThemeProvider theme={theme}>
  <LocalizationProvider dateAdapter={AdapterDayjs}>
    <Box
      sx={{
        display: 'flex',
        flexWrap: 'wrap',
        alignItems: 'flex-start',
        gap: 2,
      }}
    >
      <DateCalendar />
      <DigitalClock timeStep={60} sx={{ maxHeight: 290, width: 170 }} />
    </Box>
  </LocalizationProvider>
</ThemeProvider>