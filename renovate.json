{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>mui/mui-public//renovate/experimental"],
  "schedule": "* 0-4 * * 1",
  "lockFileMaintenance": {
    "description": "Match the schedule above, so the lockfile refresh lands in the weekly npm non-major group PR.",
    "schedule": "* 0-4 * * 1"
  },
  "packageRules": [
    {
      "groupName": "D3",
      "description": "Majors only. The D3 packages come from separate repositories, so no monorepo group keeps their majors together. Minor and patch updates join the npm non-major group.",
      "matchPackageNames": ["d3-*", "@types/d3-*"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "Base UI",
      "matchPackageNames": ["@base-ui/**"]
    },
    {
      "groupName": "pragmatic-drag-and-drop",
      "description": "Keep major and minor bumps in one PR. The addons depend on the core package, so separate bumps install two copies of it.",
      "matchSourceUrls": ["https://github.com/atlassian/pragmatic-drag-and-drop"],
      "separateMajorMinor": false
    },
    {
      "groupName": "bundling fixtures",
      "matchFileNames": ["test/bundling/fixtures/**/package.json"],
      "schedule": "* * 1 1,7 *"
    },
    {
      "matchDepNames": ["date-fns-v2"],
      "allowedVersions": "< 3.0.0"
    },
    {
      "matchPackageNames": ["recast"],
      "allowedVersions": "< 0.23.10"
    },
    {
      "matchPackageNames": ["@fingerprintjs/fingerprintjs"],
      "allowedVersions": "< 4.0.0"
    },
    {
      "description": "Prevent major version updates of pinned older @mui/x-license versions in the cross-major compat tests.",
      "matchFileNames": ["test/x-license-compat/package.json"],
      "matchPackageNames": ["@mui/x-license", "@mui/x-license-pro"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
